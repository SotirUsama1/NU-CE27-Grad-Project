# ─── Copy this file to ".env" and fill it in ───────────────────────────────

# ── GitHub (required) ──────────────────────────────────────────────────────
# Personal access token: https://github.com/settings/tokens?type=beta
# Fine-grained token with READ-ONLY access to: Contents, Issues, Pull requests, Metadata
GITHUB_TOKEN=

# Repositories to show, comma separated (owner/name)
GITHUB_REPOS=SotirUsama1/NU-CE27-Grad-Project

# ── Dashboard (optional) ───────────────────────────────────────────────────
DASHBOARD_TITLE=Graduation Project Progress: Multi-agentic LLM Robot mission planning system
# Project timeline shown in the header (YYYY-MM-DD). Start defaults to the
# repository's creation date; set the end date to get a countdown + % elapsed.
PROJECT_START_DATE=
PROJECT_END_DATE=
PORT=3000
# How long GitHub data is cached, in seconds (also the auto-refresh interval)
CACHE_TTL_SECONDS=300
# How many weeks the "commits per week" chart shows
ACTIVITY_WEEKS=12
# Set a password to protect the dashboard (strongly recommended once hosted)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Only change for GitHub Enterprise Server, e.g. https://github.mycompany.com/api/v3
GITHUB_API_URL=https://api.github.com

# ══════════════════════════════════════════════════════════════════════════
#  AWS CONNECTION SECTION – leave empty while running locally.
#  See docs/AWS.md for the full deployment guide.
# ══════════════════════════════════════════════════════════════════════════
# Where it runs: local | ecs | ec2
DEPLOY_TARGET=local
# e.g. eu-central-1 or me-south-1
AWS_REGION=
# Optional: name of a Secrets Manager secret holding GITHUB_TOKEN
# (plain text token, or JSON like {"GITHUB_TOKEN":"...","DASHBOARD_PASSWORD":"..."})
AWS_SECRET_NAME=
# The public link once hosted, shown in the dashboard's AWS panel
PUBLIC_URL=
