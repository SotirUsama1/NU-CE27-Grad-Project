<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <!--
    Grad_warehouse — NU-CE27 custom layout from AWS RoboMaker props.

    Footprint: 2x GroundB/WallB tiles along +Y  (~14 m x 42 m).
    Zones (approximate):
      RECEIVING  : south module, y ~ -10 .. -6
      STORAGE_A  : south module, east shelves (x ~ +4.7)
      STORAGE_B  : south module, west shelves (x ~ -5.8)
      STORAGE_C  : north module, east/west shelves
      PACKING    : north module, center desks
      OFFICE     : north module, north desks
    Mid wall between modules is a zone divider (AWS WallB).
  -->
  <world name="grad_warehouse">
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ========== SHELL: south module ========== -->
    <model name="shell_ground_south">
      <include>
        <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      </include>
      <pose>0.0000 0.0000 -0.0900 0.0000 0.0000 0.0000</pose>
    </model>
    <model name="shell_wall_south">
      <include>
        <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      </include>
      <pose>0.0000 0.0000 0.0000 0.0000 0.0000 0.0000</pose>
    </model>
    <model name="shell_ground_north">
      <include>
        <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      </include>
      <pose>0.0000 21.0000 -0.0900 0.0000 0.0000 0.0000</pose>
    </model>
    <model name="shell_wall_north">
      <include>
        <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      </include>
      <pose>0.0000 21.0000 0.0000 0.0000 0.0000 0.0000</pose>
    </model>

    <!-- ========== STORAGE_B (south / west) ========== -->
    <model name="storageB_shelfF_01">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      </include>
      <pose>-5.8000 -6.0000 0.0000 0.0000 0.0000 0.0000</pose>
    </model>
    <model name="storageB_shelfF_02">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      </include>
