<?xml version="1.0"?>
<package format="3">
  <name>semantic_world_manager</name>
  <version>0.1.0</version>
  <description>Fuses Gazebo entity poses with the warehouse semantic database and serves compact scene queries.</description>
  <maintainer email="mohamedabubakr450@gmail.com">MohamedAbubakr22</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
