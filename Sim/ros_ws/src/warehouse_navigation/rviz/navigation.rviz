# RViz for one robot, used as a template by launch/localization.launch.py: <robot_namespace> becomes this robot
# (/husky1), <other_namespace> another robot (/husky2), whose pose and route are drawn in orange, and
# <third_namespace> a third robot (/jackal1), drawn in purple.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 60
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: <robot_namespace>/map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.8
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: <robot_namespace>/global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.4
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: <robot_namespace>/local_costmap/costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 0.6
      Color Scheme: costmap
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: <robot_namespace>/local_costmap/published_footprint
        Reliability Policy: Reliable
      Color: 0; 255; 255
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: <robot_namespace>/plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 200; 0
      Line Style: Billboards
      Line Width: 0.06
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: <robot_namespace>/robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: <robot_namespace>/scan
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles
      Enabled: true
      Topic:
        Value: <robot_namespace>/particle_cloud
        Reliability Policy: Best Effort
      Color: 0; 180; 0
      Shape: Arrow (Flat)
      Arrow Length: 0.3
    # The other robot: AMCL's estimate of where it is, and the route its planner chose. Both are in the map
    # frame, which every robot shares, so they show up correctly on this robot's map.
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Other robot pose
      Enabled: true
      Topic:
        Value: <other_namespace>/amcl_pose
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 140; 0
      Shaft Length: 0.6
      Shaft Radius: 0.08
      Head Length: 0.3
      Head Radius: 0.18
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Path
      Name: Other robot path
      Enabled: true
      Topic:
        Value: <other_namespace>/plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 140; 0
      Line Style: Billboards
      Line Width: 0.06
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Third robot pose
      Enabled: true
      Topic:
        Value: <third_namespace>/amcl_pose
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 170; 60; 255
      Shaft Length: 0.6
      Shaft Radius: 0.08
      Head Length: 0.3
      Head Radius: 0.18
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Path
      Name: Third robot path
      Enabled: true
      Topic:
        Value: <third_namespace>/plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 170; 60; 255
      Line Style: Billboards
      Line Width: 0.06
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: <robot_namespace>/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: <robot_namespace>/goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 20
      X: 10
      Y: 10
Window Geometry:
  Width: 1200
  Height: 800
