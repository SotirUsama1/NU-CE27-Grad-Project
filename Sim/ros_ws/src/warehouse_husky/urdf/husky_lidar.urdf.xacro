<?xml version="1.0"?>
<!-- Extra parts for the Husky, included by urdf/husky.urdf.xacro: a 2D lidar on the top plate
     and contact sensors, so real collisions can be counted. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
      <material name="laser_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <!-- Front of the top plate, 0.36 m above the floor -->
  <joint name="laser_joint" type="fixed">
    <parent link="top_plate_link"/>
    <child link="laser_link"/>
    <origin xyz="0.32 0 0.04" rpy="0 0 0"/>
  </joint>

  <gazebo reference="laser_link">
    <sensor name="laser" type="ray">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>$(arg namespace)</namespace><remapping>__ns:=/$(arg namespace)</remapping>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Contact sensors, one on the body and one per wheel, on /(namespace)/contacts/(part)/bumper_states. The wheels touch the floor all the time, so they report more slowly. Comments in this file must not contain a colon followed by a space, because Gazebo passes the whole text on as a ROS parameter. -->
  <gazebo reference="base_link">
    <sensor name="base_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <contact>
        <collision>base_link_collision</collision>
        <collision>base_link_collision_1</collision>
        <collision>base_link_fixed_joint_lump__top_plate_link_collision_2</collision>
        <collision>base_link_fixed_joint_lump__laser_link_collision_3</collision>
      </contact>
      <plugin name="base_bumper" filename="libgazebo_ros_bumper.so">
        <ros><namespace>$(arg namespace)</namespace><remapping>__ns:=/$(arg namespace)</remapping><remapping>bumper_states:=contacts/base/bumper_states</remapping></ros>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="front_left_wheel">
    <sensor name="front_left_wheel_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <contact><collision>front_left_wheel_collision</collision></contact>
      <plugin name="front_left_wheel_bumper" filename="libgazebo_ros_bumper.so">
        <ros><namespace>$(arg namespace)</namespace><remapping>__ns:=/$(arg namespace)</remapping><remapping>bumper_states:=contacts/front_left_wheel/bumper_states</remapping></ros>
        <frame_name>front_left_wheel</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <sensor name="front_right_wheel_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <contact><collision>front_right_wheel_collision</collision></contact>
      <plugin name="front_right_wheel_bumper" filename="libgazebo_ros_bumper.so">
        <ros><namespace>$(arg namespace)</namespace><remapping>__ns:=/$(arg namespace)</remapping><remapping>bumper_states:=contacts/front_right_wheel/bumper_states</remapping></ros>
        <frame_name>front_right_wheel</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <sensor name="rear_left_wheel_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <contact><collision>rear_left_wheel_collision</collision></contact>
      <plugin name="rear_left_wheel_bumper" filename="libgazebo_ros_bumper.so">
        <ros><namespace>$(arg namespace)</namespace><remapping>__ns:=/$(arg namespace)</remapping><remapping>bumper_states:=contacts/rear_left_wheel/bumper_states</remapping></ros>
        <frame_name>rear_left_wheel</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="rear_right_wheel">
    <sensor name="rear_right_wheel_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <contact><collision>rear_right_wheel_collision</collision></contact>
      <plugin name="rear_right_wheel_bumper" filename="libgazebo_ros_bumper.so">
        <ros><namespace>$(arg namespace)</namespace><remapping>__ns:=/$(arg namespace)</remapping><remapping>bumper_states:=contacts/rear_right_wheel/bumper_states</remapping></ros>
        <frame_name>rear_right_wheel</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- The exact position of the robot from the simulator, for tests only (/(namespace)/ground_truth/odom). Nothing in the navigation reads it. -->
  <gazebo>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <ros><namespace>$(arg namespace)</namespace><remapping>__ns:=/$(arg namespace)</remapping><remapping>odom:=ground_truth/odom</remapping></ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>20</update_rate>
    </plugin>
  </gazebo>

</robot>
