#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
CONFIG="${CYCLONEDDS_CONFIG:-$SCRIPT_DIR/cyclonedds.xml}"
IMAGE="${ROS_IMAGE:-sotirusama/gzclassic:cyclonedds}"
DOMAIN="${ROS_DOMAIN_ID:-17}"

[[ -r "$CONFIG" ]] || {
  echo "CycloneDDS config is not readable: $CONFIG" >&2
  exit 1
}

# 1. Ensure local directories exist on the host to prevent Docker from creating them as root
mkdir -p ${SCRIPT_DIR}/../models
mkdir -p ${SCRIPT_DIR}/../worlds

# 2. Automatically permit local Docker containers to connect to the X server display
if command -v xhost &> /dev/null; then
    echo "[INFO] Granting X11 local display permissions..."
    xhost +local:docker > /dev/null
else
    echo "[WARNING] 'xhost' command not found. Ensure your X server permits container connections."
fi

# 3. A first argument of "bash" opens a shell in the configured container.
if [ "${1-}" = "bash" ]; then
    CONTAINER_MODE="bash"
    shift
    echo "[INFO] Opening a bash shell in the Gazebo Classic container..."
else
    CONTAINER_MODE="gazebo"
    if [ $# -eq 0 ]; then
        echo "[INFO] No simulation arguments provided. Defaulting to an empty world."
        set -- worlds/empty.world
    fi
    echo "[INFO] Launching Gazebo Classic Docker Container..."
    echo "[INFO] Passing arguments to gazebo: $*"
fi


docker run -it --rm \
    --net=host \
    --privileged \
    --gpus all \
    --env="DISPLAY=${DISPLAY}" \
    --env="QT_X11_NO_MITSHM=1" \
    --env="NVIDIA_DRIVER_CAPABILITIES=all" \
    --mount "type=bind,src=$(realpath "$CONFIG"),dst=/etc/cyclonedds/cyclonedds.xml,readonly" \
    -e RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    -e ROS_LOCALHOST_ONLY=0 \
    -e ROS_DOMAIN_ID="$DOMAIN" \
    -e CYCLONEDDS_URI=file:///etc/cyclonedds/cyclonedds.xml \
    --volume="/tmp/.X11-unix:/tmp/.X11-unix:rw" \
    --volume="${HOME}/.Xauthority:/root/.Xauthority:rw" \
    --volume="${SCRIPT_DIR}/../models:/main/models:rw" \
    --volume="${SCRIPT_DIR}/../worlds:/main/worlds:rw" \
    sotirusama/gzclassic:cyclonedds \
    bash -c 'source /usr/share/gazebo/setup.sh &&
             source /opt/ros/humble/setup.bash &&
             export GAZEBO_MODEL_PATH="$GAZEBO_MODEL_PATH:/main/models" &&
             export GAZEBO_RESOURCE_PATH="$GAZEBO_RESOURCE_PATH:/main/worlds" &&
             if [ "$1" = "bash" ]; then
                 exec bash -i
             else
                 shift
                 exec gazebo --verbose "$@"
             fi' -- "$CONTAINER_MODE" "$@"