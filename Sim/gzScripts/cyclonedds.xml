<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <!-- Select the network interface automatically. Set name="eth0" (or the
           interface used by your host/container) to pin Cyclone DDS to one NIC. -->
      <Interfaces>
        <NetworkInterface autodetermine="true" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>

    <Discovery>
      <Peers>
        <Peer address="xxx.xxx.xxx.xxx" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
