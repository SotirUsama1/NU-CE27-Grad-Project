<?xml version="1.0"?>
<sdf version="1.6">
    <model name="transport_robot">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>180</mass><inertia><ixx>15</ixx>
          <iyy>30.75</iyy><izz>34.95</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="body">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.3 0.8 0.5</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <collision name="deck">
          <pose>0 0 0.57 0 0 0</pose>
          <geometry><box><size>1.3 0.8 0.14</size></box></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>model://transport_robot/meshes/base.dae</uri></mesh></geometry>
        </visual>
        <sensor name="laser" type="gpu_ray">
          <pose>0.67 0 0.18 0 0 0</pose>
          <update_rate>10</update_rate>
          <ray>
            <scan><horizontal><samples>540</samples><resolution>1</resolution>
              <min_angle>-2.356</min_angle><max_angle>2.356</max_angle></horizontal></scan>
            <range><min>0.1</min><max>20</max><resolution>0.01</resolution></range>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
          </ray>
          <plugin name="laser" filename="libgazebo_ros_ray_sensor.so">
            <ros><namespace>/transport_robot</namespace><remapping>~/out:=scan</remapping></ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>transport_robot/laser</frame_name>
          </plugin>
        </sensor>
      </link>
      <plugin name="custom_robot" filename="/workspace/models/transport_robot/plugins/libcustom_robot.so">
        <ros><namespace>/transport_robot</namespace></ros>
        <role>transport</role>
        <max_speed>1.5</max_speed>
        <max_turn_rate>1.5</max_turn_rate>
        <acceleration>0.8</acceleration>
        <deck_length>1.24</deck_length>
        <deck_width>0.78</deck_width>
        <deck_top>0.64</deck_top>
        <roller_speed>0.4</roller_speed>
        <laser_pose>0.67 0 0.18 0 0 0</laser_pose>
      </plugin>
    </model>
</sdf>
