<?xml version="1.0"?>
<sdf version="1.6">
    <model name="picker_robot">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial><mass>250</mass><inertia><ixx>20.21</ixx><iyy>69.34</iyy><izz>82.88</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="chassis_front">
          <pose>0.365 0 0.0375 0 0 0</pose>
          <geometry><box><size>1.05 0.9 0.075</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <collision name="chassis_rear">
          <pose>-0.525 0 0.125 0 0 0</pose>
          <geometry><box><size>0.73 0.9 0.25</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <collision name="mast_-1">
          <pose>-0.16 -0.43 1.35 0 0 0</pose>
          <geometry><box><size>0.05 0.04 2.2</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <collision name="mast_1">
          <pose>-0.16 0.43 1.35 0 0 0</pose>
          <geometry><box><size>0.05 0.04 2.2</size></box></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <sensor name="laser" type="gpu_ray">
          <pose>0.9 0 0.05 0 0 0</pose>
          <update_rate>10</update_rate>
          <ray>
            <scan><horizontal><samples>540</samples><resolution>1</resolution>
              <min_angle>-2.356</min_angle><max_angle>2.356</max_angle></horizontal></scan>
            <range><min>0.1</min><max>20</max><resolution>0.01</resolution></range>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
          </ray>
          <plugin name="laser" filename="libgazebo_ros_ray_sensor.so">
            <ros><namespace>/picker_robot</namespace><remapping>~/out:=scan</remapping></ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>picker_robot/laser</frame_name>
          </plugin>
        </sensor>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>model://picker_robot/meshes/base.dae</uri></mesh></geometry>
        </visual>
      </link>
      <link name="carriage">
        <pose>0.37 0 0.1 0 0 0</pose>
        <inertial><mass>15</mass><inertia><ixx>0.853</ixx><iyy>1.117</iyy><izz>1.945</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>model://picker_robot/meshes/carriage.dae</uri></mesh></geometry>
        </visual>
      </link>
      <link name="stage">
        <pose>0.37 0 0.1 0 0 0</pose>
        <inertial><mass>2</mass><inertia><ixx>0.1184</ixx><iyy>0.1481</iyy><izz>0.2649</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>model://picker_robot/meshes/stage.dae</uri></mesh></geometry>
        </visual>
      </link>
      <link name="arm">
        <pose>0.37 0 0.1 0 0 0</pose>
        <inertial><mass>2</mass><inertia><ixx>0.1182</ixx><iyy>0.1356</iyy><izz>0.2526</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>model://picker_robot/meshes/arm.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="lift_joint" type="prismatic">
        <parent>base_link</parent><child>carriage</child>
        <axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>1.9</upper>
          <effort>5000</effort><velocity>1</velocity></limit></axis>
      </joint>
      <joint name="reach_joint" type="prismatic">
        <parent>carriage</parent><child>stage</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-0.75</lower><upper>0.75</upper>
          <effort>5000</effort><velocity>1</velocity></limit></axis>
      </joint>
      <joint name="reach2_joint" type="prismatic">
        <parent>stage</parent><child>arm</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-0.75</lower><upper>0.75</upper>
          <effort>5000</effort><velocity>1</velocity></limit></axis>
      </joint>
      <plugin name="custom_robot" filename="/workspace/models/picker_robot/plugins/libcustom_robot.so">
        <ros><namespace>/picker_robot</namespace></ros>
        <role>picker</role>
        <max_speed>1.2</max_speed>
        <max_turn_rate>1.2</max_turn_rate>
        <acceleration>0.8</acceleration>
        <tray_x>0.37</tray_x>
        <tray_zero>0.1</tray_zero>
        <reach_max>1.5</reach_max>
        <slot_x>-0.53</slot_x>
        <slot_heights>0.3 0.85 1.4 1.95</slot_heights>
        <aisle_half>0.78</aisle_half>
        <laser_pose>0.9 0 0.05 0 0 0</laser_pose>
      </plugin>
    </model>
</sdf>
