# CyberScape backend environment configuration.
# Copy this file to `.env` and adjust values for local development.

DATABASE_URL=postgresql://cyberscape:cyberscape@localhost:5432/cyberscape
REDIS_URL=redis://localhost:6379/0
ROSBRIDGE_WS_URL=ws://localhost:9090
TOPO_MAP_PATH=data/topo_graph.json
HEARTBEAT_TIMEOUT_S=3.0
DISPATCH_SWEEP_INTERVAL_S=7.0
AUTH_API_KEY=cyberscape-secret-key

# Optional LLM configuration (OpenAI or OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3.5-super-vl:free